{
  "name": "brewcli",
  "version": "1.0.0",
  "main": "index.js",
  "bin": {
    "create-brew-app": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"import fs from 'fs-extra'; fs.copySync('src/templates', 'dist/templates')\"",
    "postbuild": "chmod +x dist/cli.js",
    "start": "tsx src/cli.tsx"
  },
  "keywords": [
    "cli",
    "scaffolder",
    "project-generator",
    "boilerplate",
    "starter",
    "express",
    "fastify",
    "nestjs",
    "react",
    "nextjs",
    "vuejs",
    "angular",
    "react-native",
    "expo",
    "typescript",
    "javascript",
    "nodejs",
    "fullstack",
    "create-app"
  ],
  "author": "Harsh Mer",
  "contributors": [
    {
      "name": "Keval Tank",
      "url": "https://github.com/Keval-Tank"
    }
  ],
  "license": "MIT",
  "description": "An extensible CLI scaffolder for rapidly creating full-stack applications across modern JavaScript frameworks",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "fs-extra": "^11.3.4",
    "ink": "^7.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
